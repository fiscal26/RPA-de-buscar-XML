# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel
# (Project > Settings > Environment Variables). Valores em: Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-ou-publishable
# Chave secreta (service_role / secret). NUNCA use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-ou-secret

# Chave PÚBLICA do robô, que cifra as senhas do ATF. Gere no PC do robô com gerar_chaves.bat
# (ou "python robo_xml.py --gerar-chaves") e cole aqui a linha que ele mostrar.
XML_CHAVE_PUBLICA=LS0tLS1CRUdJTi...
